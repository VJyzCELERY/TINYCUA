    %% ══════════════════════════════════════════════

    style SDK fill:#e0f2fe,stroke:#0284c7,color:#1e293b
    style Loop fill:#e0f2fe,stroke:#0284c7,color:#1e293b
    style NQ fill:#e0f2fe,stroke:#0284c7,color:#1e293b
    style Entry fill:#dbeafe,stroke:#2563eb,color:#1e293b
    style Planning fill:#dbeafe,stroke:#2563eb,color:#1e293b
    style Execution fill:#dbeafe,stroke:#2563eb,color:#1e293b
    style Output fill:#dbeafe,stroke:#2563eb,color:#1e293b
    style OnDemand fill:#ede9fe,stroke:#7c3aed,color:#1e293b
    style DN fill:#ede9fe,stroke:#7c3aed,color:#1e293b
    style WK fill:#ccfbf1,stroke:#14b8a6,color:#1e293b
    style Policies fill:#f1f5f9,stroke:#64748b,color:#1e293b
    style State fill:#ede9fe,stroke:#7c3aed,color:#1e293b
    style Compact fill:#fee2e2,stroke:#ef4444,color:#1e293b
    style Tools fill:#f1f5f9,stroke:#64748b,color:#1e293b
    style RS fill:#ede9fe,stroke:#7c3aed,color:#1e293b

    style User fill:#f43f5e,stroke:#fff,color:#fff
    style UserWait fill:#38bdf8,stroke:#fff,color:#fff

    %% DecisionNode — vivid purple, light fill
    style QA fill:#c084fc,stroke:#7c3aed,color:#fff
    style WN fill:#c084fc,stroke:#7c3aed,color:#fff

    %% ProcessNode — bright blue, light fill
    style TC fill:#38bdf8,stroke:#0284c7,color:#fff
    style TA fill:#38bdf8,stroke:#0284c7,color:#fff
    style AE fill:#38bdf8,stroke:#0284c7,color:#fff
    style TASS fill:#38bdf8,stroke:#0284c7,color:#fff

    %% Executor — bright red
    style TEX fill:#f87171,stroke:#dc2626,color:#fff

    %% Reviewer — bright amber
    style RR fill:#fbbf24,stroke:#d97706,color:#000

    %% Aggregation — bright teal
    style RAG fill:#2dd4bf,stroke:#0d9488,color:#fff

    %% Response — bright slate
    style RESP fill:#94a3b8,stroke:#475569,color:#fff

    %% Digester — bright violet
    style ID fill:#c084fc,stroke:#7c3aed,color:#fff
