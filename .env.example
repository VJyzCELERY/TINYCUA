# TinyCUA Benchmark Docker Environment Configuration
# Copy this file to .env and adjust values before running docker compose.

# Required: Local OpenAI-compatible model endpoint
TINYCUA_BASE_URL=http://host.docker.internal:1234/v1

# Optional: API key for model endpoint (leave empty for local endpoints)
TINYCUA_API_KEY=

# Optional: Model name (default: llama3)
TINYCUA_MODEL=llama3

# Required: WildClawBench task prompt (set by benchmark harness)
# TASK_PROMPT=your task prompt here

# Optional: Tool API keys
BRAVE_API_KEY=

# SearXNG web search endpoint for the web_search tool.
# Defaults to http://localhost:8080/search when unset.
TINYCUA_SEARXNG_URL=

# Optional: Runtime configuration
TINYCUA_LOG_LEVEL=INFO
TINYCUA_TIMEOUT=300
