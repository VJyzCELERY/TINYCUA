# TINYCUA Configuration

# Backend Configuration
TINYCUA_BACKEND_URL=http://localhost:8000
TINYCUA_BACKEND_API_KEY=your-api-key-here

# Default Provider (use "openai-chat-completions" for Qwen / local LM Studio models;
# use "openai-responses" for OpenAI API or LM Studio models that support /v1/responses)
TINYCUA_PROVIDER=openai-chat-completions
TINYCUA_MODEL=qwen/qwen3.5-9b
TINYCUA_BASE_URL=http://localhost:1234/v1

LLM_API_KEY=dummy