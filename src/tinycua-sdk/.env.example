# TINYCUA Configuration

# Backend Configuration
TINYCUA_BACKEND_URL=http://localhost:8000
TINYCUA_BACKEND_API_KEY=your-api-key-here

# Default Provider (use "openai-chat-completions" for Qwen / local LM Studio models;
# use "openai-responses" for OpenAI API or LM Studio models that support /v1/responses)
TINYCUA_PROVIDER=openai-chat-completions
TINYCUA_MODEL=qwen/qwen3.5-9b
TINYCUA_BASE_URL=http://localhost:1234/v1
TINYCUA_API_KEY=dummy

# Provider-specific overrides (take precedence over TINYCUA_* and LLM_* env vars)
# OpenAI Responses provider
# OPENAI_RESPONSES_BASE_URL=https://api.openai.com/v1
# OPENAI_RESPONSES_API_KEY=sk-...
# OPENAI_RESPONSES_MODEL=gpt-4o-mini

# OpenAI Chat Completions provider
# OPENAI_CHAT_COMPLETIONS_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_COMPLETIONS_API_KEY=sk-...
# OPENAI_CHAT_COMPLETIONS_MODEL=gpt-4o-mini

# Generic OpenAPI-compatible fallback (used when no provider-specific var is set)
LLM_API_KEY=dummy