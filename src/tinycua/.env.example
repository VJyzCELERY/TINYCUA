# TinyCUA CLI example
#
# 1. Copy this file to .env
# 2. Fill in the values for your model server
# 3. Run from src/tinycua:
#    uv run tinycua run --dir ./tmp/live-workspace "Say hello"
#    (streaming is always on; --dir defaults to the current working directory)

# Provider base URL and credentials used by `tinycua run`.
TINYCUA_BASE_URL=http://localhost:1234/v1
TINYCUA_API_KEY=tinycua-local-test
TINYCUA_MODEL=qwen/qwen3.5-4b

# Provider API type: openai-chat-completions or openai-responses.
# Defaults to openai-chat-completions when unset.
TINYCUA_PROVIDER_TYPE=openai-chat-completions

# Provider-specific aliases used by direct provider configuration paths.
OPENAI_CHAT_COMPLETIONS_BASE_URL=http://localhost:1234/v1
OPENAI_CHAT_COMPLETIONS_API_KEY=tinycua-local-test
OPENAI_CHAT_COMPLETIONS_MODEL=qwen/qwen3.5-4b

# Shared fallback model env vars.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen/qwen3.5-4b

# Worker analysis effort: none, low, medium, or high.
# Defaults to medium when unset.
TINYCUA_WORKER_EFFORT=medium

# Optional backend/dev settings. The `tinycua run` command does not require these.
TINYCUA_BACKEND_URL=http://localhost:8000
TINYCUA_DATABASE_URL=sqlite:///./tinycua.db
TINYCUA_ENV=dev
