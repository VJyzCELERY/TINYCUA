o(\n                    x1 + (radius - 80) * Math.cos(angle),\n                    centerY + (radius - 80) * Math.sin(angle)\n                );\n                ctx.strokeStyle = '#ffffff';\n                ctx.lineWidth = 3;\n                ctx.stroke();\n\n                // Inner shorter line for numbers\n                const x2 = centerX + (radius - 65) * Math.cos(angle);\n                const y2 = centerY + (radius - 65) * Math.sin(angle);\n                \n                ctx.beginPath();\n                ctx.moveTo(x1, y1);\n                ctx.lineTo(x2, y2);\n                ctx.stroke();\n\n                // Draw numbers\n                ctx.save();\n                ctx.translate(centerX, centerY);\n                ctx.rotate(angle + Math.PI / 2);\n                ctx.textAlign = 'right';\n                ctx.fillStyle = '#ffffff';\n                ctx.font = 'bold 16px Arial';\n                ctx.fillText(i === 12 ? 12 : i, radius - 50, 7);\n                ctx.restore();\n            }\n\n            // Draw minute track\n            ctx.beginPath();\n            ctx.arc(centerX, centerY, radius - 90, 0, Math.PI * 2);\n            ctx.strokeStyle = '#3a3a5e';\n            ctx.lineWidth = 1;\n            ctx.stroke();\n\n            // Get current time\n            const now = new Date();\n            const seconds = now.getSeconds();\n            const milliseconds = now.getMilliseconds();\n            const minutes = now.getMinutes();\n            const hours = now.getHours() % 12 || 12;\n\n            // Calculate hand angles with smooth animation for seconds\n            const secondAngle = (seconds + milliseconds / 1000) * 6;\n            const minuteAngle = minutes * 6 + seconds * 0.1;\n            const hourAngle = (hours + minutes / 60) * 30;\n\n            // Draw center circle\n            ctx.beginPath();\n            ctx.arc(centerX, centerY, 25, 0, Math.PI * 2);\n            ctx.fillStyle = '#ffffff';\n            ctx.fill();\n        