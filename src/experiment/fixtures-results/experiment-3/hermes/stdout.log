     Date().getSeconds(); }\nfunction getMinutes() { return new Date().getMinutes(); }\nfunction getHours() {\n    const
     h = new Date().getHours();\n    const m = new Date().getMinutes();\n    return (h % 12) + m / 60;\n}\n\nfunction
     drawClock() {\n    ctx.fillStyle = '#1a1a2e';\n    ctx.fillRect(0, 0, canvas.width, canvas.height);\n\n    // Outer
     ring\n    ctx.beginPath();\n    ctx.arc(centerX, centerY, radius, 0, Math.PI * 2);\n    ctx.strokeStyle =
     '#2a2a4e';\n    ctx.lineWidth = 15;\n    ctx.stroke();\n\n    // Hour markers\n    for (let i = 0; i < 12; i++) {\n
     const angle = (i * Math.PI) / 6 - Math.PI / 2;\n        ctx.beginPath();\n        ctx.arc(centerX, centerY, radius
     - 35, angle, angle + Math.PI / 6);\n        ctx.strokeStyle = '#4a4a7e';\n        ctx.lineWidth = 3;\n
     ctx.stroke();\n\n        const labelRadius = radius - 50;\n        const labelAngle = (i * Math.PI) / 6 - Math.PI /
     2;\n        const labelX = centerX + Math.cos(labelAngle) * (labelRadius - 10);\n        const labelY = centerY +
     Math.sin(labelAngle) * (labelRadius - 10);\n\n        ctx.fillStyle = '#aaa';\n        ctx.font = 'bold 24px
     Arial';\n        ctx.textAlign = 'center';\n        ctx.textBaseline = 'middle';\n        ctx.fillText(i === 3 ?
     'III' : i === 9 ? 'IX' : i, labelX, labelY);\n    }\n\n    // Minute marks (small ticks)\n    for (let m = 0; m <
     60; m++) {\n        if (m % 5 === 0) continue;\n        const angle = (m * Math.PI) / 30 - Math.PI / 2;\n
     ctx.beginPath();\n        ctx.arc(centerX, centerY, radius - 38, angle, angle + Math.PI / 30);\n
     ctx.strokeStyle = '#3a3a6e';\n        ctx.lineWidth = 1;\n        ctx.stroke();\n    }\n\n    // Center point\n
     ctx.beginPath();\n    ctx.arc(centerX, centerY, 5, 0, Math.PI * 2);\n    ctx.fillStyle = '#fff';\n
     ctx.fill();\n\n    const seconds = getSeconds();\n    const minutes = getMinutes();\n    const hours =
     getHours();\n\n    // Second hand (red) - moves every second\n    const secondAngle = (seconds / 60) * Math.PI *
     2;\n    ctx.beginPath();\n    ctx.moveTo(centerX, centerY);\n    ctx.lineTo(\n        centerX +
     Math.cos(secondAngle - Math.PI / 2) * (radius - 15),\n        centerY + Math.sin(secondAngle - Math.PI / 2) *
     (radius - 15)\n    );\n    ctx.strokeStyle = '#ff4444';\n    ctx.lineWidth = 3;\n    ctx.stroke();\n\n    // Minute
     hand (blue)\n    const minuteAngle = ((minutes + seconds / 60) / 60) * Math.PI * 2;\n    ctx.beginPath();\n
     ctx.moveTo(centerX, centerY);\n    ctx.lineTo(\n        centerX + Math.cos(minuteAngle - Math.PI / 2) * (radius -
     45),\n        centerY + Math.sin(minuteAngle - Math.PI / 2) * (radius - 45)\n    );\n    ctx.strokeStyle =
     '#00ccff';\n    ctx.lineWidth = 6;\n    ctx.stroke();\n\n    // Hour hand (white)\n    const hourAngle = ((hours) /
     12) * Math.PI * 2;\n    ctx.beginPath();\n    ctx.moveTo(centerX, centerY);\n    ctx.lineTo(\n        centerX +
     Math.cos(hourAngle - Math.PI / 2) * (radius - 75),\n        centerY + Math.sin(hourAngle - Math.PI / 2) * (radius -
     75)\n    );\n    ctx.strokeStyle = '#ffffff';\n    ctx.lineWidth = 6;\n    ctx.stroke();\n\n    // Update every
     frame using requestAnimationFrame\n
     requestAnimationFrame(drawClock);\n}\n\ndrawClock();\n</script>\n</body>\n</html>\nENDOFFILE"
     }
