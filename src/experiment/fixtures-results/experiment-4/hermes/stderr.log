.route('/api/blocks/<int:block_id>', methods=['DELETE'])\n134|def delete_block(block_id):\n135|    \"\"\"Delete a block.\"\"\"\n136|    db = get_db()\n137|    \n138|    cursor = db.cursor()\n139|    cursor.execute('SELECT position FROM blocks WHERE id=?', (block_id,))\n140|    row = cursor.fetchone()\n141|    \n142|    if not row:\n143|        return jsonify({'error': 'Block not found'}), 404\n144|    \n145|    cursor.execute('DELETE FROM blocks WHERE id=?', (block_id,))\n146|    db.commit()\n147|    db.close()\n148|    \n149|    return jsonify({'success': True})\n150|\n151|\n152|@app.route('/api/blocks/reorder', methods=['POST'])\n153|def reorder_blocks():\n154|    \"\"\"Reorder multiple blocks.\"\"\"\n155|    data = request.json\n156|    positions = data.get('positions', [])\n157|    \n158|    if not positions:\n159|        return jsonify({'error': 'No positions provided'}), 400\n160|    \n161|    db = get_db()\n162|    cursor = db.cursor()\n163|    \n164|    # Update all blocks with new positions\n165|    for item in positions:\n166|        block_id = item['id']\n167|        position = item['position']\n168|        cursor.execute(\n169|            'UPDATE blocks SET position=? WHERE id=?',\n170|            (position, block_id)\n171|        )\n172|    \n173|    db.commit()\n174|    db.close()\n175|    \n176|    return jsonify({'success': True})\n177|\n178|\n179|if __name__ == '__main__':\n180|    init_db()\n181|    app.run(host='0.0.0.0', port=int(os.environ.get('PORT', 8765)), debug=True)\n182|", "total_lines": 181, "file_size": 4577, "truncated": false, "is_binary": false, "is_image": false}
