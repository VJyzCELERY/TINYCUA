ock\" to add one</p>\n        </div>\n    </div>\n    \n    <div class=\"toolbar\">\n        <button onclick=\"addBlock()\">+ New Block</button>\n        <button class=\"primary\" onclick=\"deleteSelected()\">Delete Selected</button>\n    </div>\n\n    <script>\n        let selectedBlock = null;\n        \n        async function loadBlocks() {\n            try {\n                const response = await fetch('/api/blocks');\n                const blocks = await response.json();\n                \n                const container = document.getElementById('blocks-container');\n                const emptyState = document.getElementById('empty-state');\n                \n                if (blocks.length === 0) {\n                    container.innerHTML = '';\n                    emptyState.style.display = 'block';\n                } else {\n                    emptyState.style.display = 'none';\n                    container.innerHTML = blocks.map(block => createBlockElement(block)).join('');\n                }\n            } catch (error) {\n                console.error('Error loading blocks:', error);\n            }\n        }\n        \n        function createBlockElement(block) {\n            return \\`\n                <div class=\"block \\${block.id === selectedBlock ? 'selected' : ''}\" \n                     data-id=\"\\${block.id}\" tabindex=\"0\" onkeydown=[REDACTED], '\\${block.id}')\">\n                    <span class=\"block-content\">\\${escapeHtml(block.content)}</span>\n                </div>\n            \\`;\n        }\n        \n        async function handleBlockKeydown(event, blockId) {\n            if (event.key=[REDACTED] 'Enter' || event.key=[REDACTED] ' ') {\n                event.preventDefault();\n                selectedBlock = blockId;\n                updateSelectedBlock(blockId);\n            } else if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'delete') {\n                await deleteSelected();\n            }\n     