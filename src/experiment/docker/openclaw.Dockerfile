FROM node:24-slim

RUN npm install -g openclaw@latest

CMD ["sh", "-lc", "mkdir -p ~/.openclaw; printf '%s' '{\"tools\":{\"profile\":\"minimal\"},\"agents\":{\"list\":[{\"id\":\"main\",\"default\":true,\"workspace\":\"/workspace\"}],\"defaults\":{\"model\":{\"primary\":\"local/'\"$EXPERIMENT_LLM_MODEL\"'\"},\"models\":{\"local/'\"$EXPERIMENT_LLM_MODEL\"'\":{\"alias\":\"local\"}}}},\"models\":{\"mode\":\"merge\",\"providers\":{\"local\":{\"baseUrl\":\"'\"$EXPERIMENT_LLM_BASE_URL\"'\",\"apiKey\":\"'\"$EXPERIMENT_LLM_API_KEY\"'\",\"api\":\"openai-completions\",\"models\":[{\"id\":\"'\"$EXPERIMENT_LLM_MODEL\"'\",\"name\":\"'\"$EXPERIMENT_LLM_MODEL\"'\",\"input\":[\"text\"],\"contextWindow\":128000,\"contextTokens\":120000,\"maxTokens\":4096,\"compat\":{\"requiresStringContent\":true,\"strictMessageKeys\":true}}]}}}}' > ~/.openclaw/openclaw.json; openclaw agent --local --agent main --session-key \"agent:main:experiment-${EXPERIMENT_NUM}\" --message \"$EXPERIMENT_PROMPT\" --model \"${EXPERIMENT_OPENCLAW_MODEL:-local/$EXPERIMENT_LLM_MODEL}\" --thinking \"${EXPERIMENT_OPENCLAW_THINKING:-off}\" --timeout \"${EXPERIMENT_TIMEOUT_SECONDS:-3600}\""]
