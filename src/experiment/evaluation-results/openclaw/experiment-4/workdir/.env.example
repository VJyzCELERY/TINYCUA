# Environment Configuration for Notion-like Web Application
# Copy this file to .env and modify values as needed

# ============================================
# Security Settings (REQUIRED in production)
# Generate a new key with: openssl rand -hex 32
=============================================
SECRET_KEY=change-me-in-production-secure-random-key-here-minimum-32-chars-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# Database Configuration
# Options: sqlite:///./notion.db or postgresql+asyncpg://user:pass@host/dbname
=============================================
DATABASE_URL=sqlite:///./notion.db
DATABASE_TYPE=sqlite  # Change to 'postgres' if using PostgreSQL

# ============================================
# CORS Settings - Frontend URL(s) Allowed
# Comma-separated list of origins (e.g., http://localhost:3000)
=============================================
CORS_ORIGIS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Application Settings
=============================================
APP_NAME=Notion-like App
API_VERSION=v1
DEBUG=true  # Set to False in production for better performance and security

# ============================================
# File Upload Configuration (Optional)
# Path is relative to app directory by default
=============================================
UPLOAD_DIR=./uploads/images
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,svg,pdf
