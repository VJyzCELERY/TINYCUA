# Hermes Agent Docker image for WildClawBench benchmarking.
#
# Installs hermes-agent from pip (NousResearch/hermes-agent). Runs in
# one-shot mode: receives TASK_PROMPT via env var, executes agent,
# saves transcript, exits.
#
# Build:
#   docker build -f docker/Dockerfile.hermes -t wildclawbench-hermes-agent .
#
# Run:
#   docker run --rm \
#     -e TASK_PROMPT="your task" \
#     -e HERMES_MODEL="openrouter/anthropic/claude-sonnet-4" \
#     -e OPENROUTER_API_KEY="sk-or-..." \
#     -v /path/to/results:/tmp_workspace/results \
#     -v /path/to/workspace:/tmp_workspace/workspace \
#     --add-host=host.docker.internal:host-gateway \
#     wildclawbench-hermes-agent

FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    coreutils \
    curl \
    git \
    wget \
    ca-certificates \
    # Node.js (required by hermes-agent for some tools)
    ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Install hermes-agent
RUN pip install --no-cache-dir hermes-agent

# Create directories
RUN mkdir -p /opt/hermes \
    && mkdir -p /root/.hermes \
    && mkdir -p /tmp_workspace/results \
    && mkdir -p /tmp_workspace/workspace

WORKDIR /tmp_workspace

# Copy entrypoint
COPY docker/entrypoint-hermes.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["--help"]

LABEL org.opencontainers.image.source="https://github.com/TINYCUA/TINYCUA"
LABEL org.opencontainers.image.description="Hermes agent (NousResearch) — WildClawBench benchmark harness"
