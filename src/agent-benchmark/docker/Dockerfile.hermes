# Hermes Agent Docker image for WildClawBench benchmarking.
#
# Multi-stage build based on upstream WildClawBench Hermes agent at
# https://github.com/InternLM/WildClawBench/tree/86d7144/src/agents/hermesagent
#
# Expected image size: ~5GB (base Python + dependencies).
# Pin intentionally — update by changing the COMMIT argument.
#
# Usage:
#   docker build -f docker/Dockerfile.hermes -t hermes-agent .

ARG HERMES_COMMIT=86d7144
ARG BASE_IMAGE=python:3.12-slim

# ---- Stage 1: base ----
FROM ${BASE_IMAGE} AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone pinned Hermes agent
ARG HERMES_COMMIT
RUN git clone https://github.com/InternLM/WildClawBench.git /app/wildclawbench && \
    cd /app/wildclawbench && \
    git checkout ${HERMES_COMMIT}

WORKDIR /app/wildclawbench/src/agents/hermesagent

# ---- Stage 2: dependencies ----
FROM base AS deps

RUN pip install --no-cache-dir -r requirements.txt

# ---- Stage 3: runtime ----
FROM deps AS runtime

COPY . /app/wildclawbench

ENV PYTHONUNBUFFERED=1
ENV HERMES_CONFIG=/workspace/hermes-config.yaml

ENTRYPOINT ["python", "-m", "hermes_agent"]
CMD ["--help"]

# Document labels
LABEL org.opencontainers.image.source="https://github.com/InternLM/WildClawBench"
LABEL org.opencontainers.image.description="Hermes agent — WildClawBench benchmark harness"
LABEL org.opencontainers.image.version="${HERMES_COMMIT}"
