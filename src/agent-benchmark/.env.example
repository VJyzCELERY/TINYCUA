# WildClawBench Environment Configuration
# Copy to .env and set your API keys before running.

# Provider Configuration (can also use provider-config.yaml)
# PROVIDER_NAME=lm-studio
# PROVIDER_API_BASE=http://localhost:1234/v1
# PROVIDER_MODEL=qwen3.5-9b
# PROVIDER_API_KEY_ENV=LM_STUDIO_API_KEY

# Provider-specific API Keys
# LM Studio (local, no key required)
LM_STUDIO_API_KEY=lm-studio

# Ollama (local, no key required)
OLLAMA_API_KEY=ollama

# OpenRouter (https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# vLLM (local/remote)
# VLLM_API_KEY=your_vllm_key_here

# SearXNG Local Search (no API key required)
# SearXNG starts automatically with benchmark.sh
# Manual control: bash benchmark.sh searxng {up|down|status}
SEARXNG_URL=http://localhost:8888

# Optional: Default model to evaluate
DEFAULT_MODEL=qwen3.5-9b

# Optional: Judge model for grading
JUDGE_MODEL=openai/gpt-5.4

# Optional: Runtime settings
LOG_LEVEL=INFO
TIMEOUT=600
