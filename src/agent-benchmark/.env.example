# WildClawBench Agent Benchmark Environment Configuration
# These are auto-configured by benchmark.sh — no manual setup needed.
# Run: bash benchmark.sh

# Provider (saved to .provider-config by setup wizard)
PROVIDER_NAME=lm-studio
PROVIDER_API_BASE=http://localhost:1234/v1
PROVIDER_MODEL=qwen3.5-9b
PROVIDER_API_KEY_ENV=LM_STUDIO_API_KEY

# API Keys (saved to .env by setup wizard when needed)
OPENROUTER_API_KEY=your_key_here
LM_STUDIO_API_KEY=lm-studio
OLLAMA_API_KEY=ollama
LOCAL_CUSTOM_API_KEY=lm-studio
CUSTOM_API_KEY=your_custom_key_here

# Local search (set automatically by benchmark.sh)
SEARXNG_URL=http://localhost:8888

# Runtime (optional)
LOG_LEVEL=INFO
TIMEOUT=600
# Set TIMEOUT=0 for unlimited (no timeout)
