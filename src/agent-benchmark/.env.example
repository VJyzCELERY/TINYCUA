# WildClawBench Environment Configuration
# Copy to .env and set your API keys before running.

# Required: OpenRouter API Key (https://openrouter.ai/)
OPENROUTER_API_KEY=your_api_key_here

# Required: Brave Search API Key (https://brave.com/search/api/)
BRAVE_API_KEY=your_brave_key_here

# Optional: Default model to evaluate
DEFAULT_MODEL=qwen3.5-9b

# Optional: Judge model for grading
JUDGE_MODEL=openai/gpt-5.4

# Optional: Runtime settings
LOG_LEVEL=INFO
TIMEOUT=600
